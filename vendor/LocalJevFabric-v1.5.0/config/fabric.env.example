# LocalJevFabric v1.5.0. Keep loopback unless FABRIC_API_KEY is set.
FABRIC_HOST=127.0.0.1
FABRIC_PORT=8090
FABRIC_MODEL=local-jev-fabric
FABRIC_REGISTRY=./config/tasks.registry.json

# Recommended for any registry that can authorize specialists/direct execution.
# Use a long random secret and keep it outside the registry file.
# FABRIC_REGISTRY_HMAC_KEY=replace-with-random-secret
# FABRIC_REGISTRY_REQUIRE_HMAC=true

# Optional anti-rollback controls. The checkpoint is HMAC-sealed with the registry key.
# It prevents stale/same-revision registry substitution relative to the checkpoint.
# Pin MIN_REVISION in deployment state when you need a floor that survives file rollback.
# FABRIC_REGISTRY_CHECKPOINT=./state/tasks.registry.checkpoint.json
# FABRIC_REGISTRY_MIN_REVISION=0

# Tamper-evident decision log. Raw state/prompts are not written.
FABRIC_AUDIT_LOG=./logs/jev-fabric-audit.jsonl
# Optional HMAC-sealed audit head: detects tail truncation relative to the checkpoint.
# FABRIC_AUDIT_HMAC_KEY=replace-with-a-different-random-secret
# FABRIC_AUDIT_CHECKPOINT=./logs/jev-fabric-audit.checkpoint.json
FABRIC_INCLUDE_PROVENANCE=true

# Optional, non-authoritative promotion journal. Stores exact question definitions and decision
# metadata for UNREGISTERED tasks only; it never stores request state and cannot grant authority.
# FABRIC_PROMOTION_JOURNAL=./logs/jev-fabric-promotion.jsonl
# Separate HMAC key used by offline qualification artifacts. Keep this distinct from the registry key.
# FABRIC_PROMOTION_HMAC_KEY=replace-with-another-random-secret

# v1.4 rollout evidence. Shadow/canary journals store no request state.
# FABRIC_SHADOW_JOURNAL=./logs/jev-fabric-shadow.jsonl
# FABRIC_OUTCOMES=./logs/jev-fabric-outcomes.jsonl

# Optional observable-behavior drift profile generated by `jev-fabric-drift`.
# FABRIC_DRIFT_PROFILE=./evidence/drift-profile.json
# FABRIC_DRIFT_WINDOW=100
# FABRIC_DRIFT_MIN_SAMPLES=30
# FABRIC_DRIFT_DEGRADED_Z=2.5
# FABRIC_DRIFT_DISABLED_Z=4.0
# FABRIC_DRIFT_DEGRADED_JS=0.15
# FABRIC_DRIFT_DISABLED_JS=0.30


# v1.5 capability-aware routing and cost-aware escalation. Capability data can reorder
# generalists but can never grant direct authority.
# FABRIC_CAPABILITY_MANIFEST=./config/capabilities.json
# FABRIC_ESCALATION_ERROR_COST=1.0
# FABRIC_ESCALATION_COST_WEIGHT=0.02
# FABRIC_ESCALATION_LATENCY_WEIGHT=0.01
# FABRIC_ESCALATION_MIN_EXPECTED_GAIN=0.0

# Sanitized replay/incident evidence and OTel-style JSONL telemetry. Neither stores raw state.
# FABRIC_REPLAY_STORE=./logs/jev-fabric-replay.jsonl
# FABRIC_TELEMETRY_JSONL=./logs/jev-fabric-telemetry.jsonl

# Generalist: LLM2Jev (included). URL is the server root; Fabric appends /v1/systemone.
LLM2JEV_URL=http://127.0.0.1:30000
LLM2JEV_MODEL=qwen-local
LLM2JEV_SCORE_SEMANTICS=concentration
LLM2JEV_FAILURE_THRESHOLD=3
LLM2JEV_COOLDOWN_S=30
LLM2JEV_MAX_CONCURRENCY=4

# Optional dedicated generalist such as Laya, if you run a Jev-compatible Laya server.
# LAYA_URL=http://127.0.0.1:8000
# LAYA_MODEL=laya
# LAYA_SCORE_SEMANTICS=concentration

# Optional AnyJev specialist server (included; requires trained exact-task L2 artifacts).
# Direct authority additionally requires AnyJev to run with --calibration-report.
# ANYJEV_URL=http://127.0.0.1:8101
# ANYJEV_MODEL=anyjev
# ANYJEV_SCORE_SEMANTICS=calibrated
# ANYJEV_ATTESTATION_TTL_S=60

# Order used for unseen questions and specialist failover.
FABRIC_GENERALIST_ORDER=llm2jev

# For LAN/network exposure, set a strong bearer token. Without one, non-loopback startup fails.
# FABRIC_API_KEY=replace-with-random-token
