# jev-gateway -> LocalJevFabric
HOST=127.0.0.1
PORT=8787
JEV_URL=http://127.0.0.1:8090/v1/systemone
JEV_MODEL=local-jev-fabric
JEV_TIMEOUT_MS=8000

# LLM API that the gateway proxies after the decision.
UPSTREAM_BASE_URL=https://api.openai.com/v1
# UPSTREAM_API_KEY=...

# Decision thresholds. These are concentration thresholds unless your selected backend is
# empirically calibrated. Do not interpret 0.80 as "80% probability correct" by default.
JEV_MIN_CONFIDENCE=0.70
JEV_ARG_MIN_CERTAINTY=0.80
JEV_DIRECT_CALLS=true
# v1.5: direct calls require LocalJevFabric authority envelope v4, including independent evaluator and artifact-signing provenance.
JEV_DIRECT_REQUIRE_AUTHORITY=true

# Unknown tools default to R1: they can be forced for the upstream LLM, but never executed direct.
# R0 = observational/read-only; R1 = reversible/local mutation; R2 = external side effect;
# R3 = destructive/privileged.
JEV_UNKNOWN_TOOL_RISK=R1
JEV_TOOL_RISK_JSON={"read_file":"R0","list_files":"R0","search":"R0","send_email":"R2","deploy_production":"R3","delete_database":"R3"}

# Required if HOST is not loopback. The gateway refuses unauthenticated network exposure.
# ROUTER_API_KEY=replace-with-random-token
